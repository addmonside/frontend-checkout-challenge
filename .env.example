# --- API ---
# Адрес привязки. Для docker compose нужен 0.0.0.0.
HOST=0.0.0.0
PORT=4000
# Optional absolute path; default is <repository>/.data/store.json
# DATA_FILE=/absolute/path/to/store.json
PAYMENT_DELAY_MS=3000
# Comma-separated frontend origins. Localhost on any port is allowed by default.
# CORS_ORIGINS=https://your-frontend.example

# --- web (docker compose) ---
# Публичный адрес API, по которому браузер достучится до бэкенда.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Адрес API для серверных компонентов; внутри docker-сети используется api:4000.
NEXT_PUBLIC_API_URL_FOR_SERVER_COMPONENTS=http://api:4000
NEXT_PUBLIC_DEVTOOLS_ENABLED=true
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# --- docker compose: публикация портов на хосте ---
API_HOST_PORT=4000
WEB_HOST_PORT=3000